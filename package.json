{
	"name": "worker",
	"type": "module",
	"scripts": {
		"test": "bun test",
		"test:runtime": "node scripts/failed-clicks.runtime.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"check": "pnpm test && pnpm test:runtime && pnpm typecheck && pnpm lint && pnpm fmt:check",
		"dev": "wrangler dev --env dev",
		"deploy:dry-run": "wrangler deploy --env=\"\" --dry-run",
		"deploy:dev": "wrangler deploy --env dev --minify",
		"deploy:prod": "wrangler deploy --env=\"\" --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings"
	},
	"dependencies": {
		"@upstash/redis": "^1.41.1",
		"hono": "^4.13.22"
	},
	"devDependencies": {
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"oxlint-tsgolint": "^7.0.2008",
		"typescript": "^7.0.2",
		"wrangler": "^4.168.0"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@11.9.0"
}
